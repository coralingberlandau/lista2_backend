# Copy this file to  myproj/.env  (next to settings.py) and fill in the values.
# The real .env is git-ignored and must never be committed.
# On a hosting service (e.g. PythonAnywhere) set the same names as environment variables.

# --- Required ------------------------------------------------------------------------
# Django's secret key. Use a long random string (50+ characters) and keep it private.
# Generate one with:
#   python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
SECRET_KEY=

# Password-reset emails are sent through Brevo (free plan). Create an account, add and
# verify your sender address, then create an API key (Brevo > SMTP & API > API keys).
BREVO_API_KEY=

# --- Optional (the defaults are shown) -----------------------------------------------
# Debug mode: show detailed error pages. Use True on your own computer only, never online.
DEBUG=False

# Comma-separated host names this server answers to (your server's address first).
# Default: lista-backend-n3la.onrender.com,localhost,127.0.0.1
ALLOWED_HOSTS=yourname.pythonanywhere.com,localhost,127.0.0.1

# Comma-separated websites allowed to call this API from a browser.
# Default: http://localhost:8081,https://lista-project.netlify.app
CORS_ALLOWED_ORIGINS=https://your-site.netlify.app,http://localhost:8081

# The sender address and display name (the address must be verified in Brevo).
# Default: listaassistance@gmail.com / Lista
DEFAULT_FROM_EMAIL=listaassistance@gmail.com
EMAIL_SENDER_NAME=Lista

# Address of the website, used to build the link in password-reset emails.
# Default: https://lista-project.netlify.app
FRONTEND_URL=https://your-site.netlify.app
